# Environment variables (copy to .env and fill in)
DATABASE_URL=sqlite:///./trader.db
# Neon: `neon env pull` writes DATABASE_URL (pooled) + DATABASE_URL_UNPOOLED (direct, for DDL) into .env.local
DATABASE_URL_UNPOOLED=
SESSION_SECRET=change-me
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Alpaca (paper only — never use live keys)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
EXPECTED_PAPER_ACCOUNT=

# Gemini (free key: aistudio.google.com/apikey). Blank = deterministic fallbacks
GEMINI_API_KEY=

# App
AGENT_ENABLED=true
TRADING_FROZEN=false
ADMIN_TOKEN=dev-admin-token

# Wallet addresses allowed to sign approvals (comma-separated). Empty = nobody can approve.
APPROVER_ADDRESSES=
